<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fruit_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <!--
      layout_height="match_parent" + fillViewport="true" permite usar layout_weight
      en los espaciadores para centrar verticalmente el bloque de resultado.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="40dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <!-- Imagen analizada: 200x200dp centrada, sin recorte, sin borde ni sombra -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imageCard"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivResultPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/result_image_description"
                android:scaleType="centerInside"
                tools:src="@tools:sample/avatars" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Espacio flexible superior: centra el bloque de resultado bajo la imagen -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Icono + etiqueta de estado centrados horizontalmente -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivResultStatusIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                tools:src="@android:drawable/checkbox_on_background" />

            <TextView
                android:id="@+id/tvResultStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAlignment="center"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="Fresca"
                tools:textColor="@color/fruit_fresh" />
        </LinearLayout>

        <!-- Confianza: secundaria, centrada -->
        <TextView
            android:id="@+id/tvResultConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.5"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/fruit_on_surface"
            android:textSize="15sp"
            tools:text="93% de confianza" />

        <!-- Mensaje: terciario, centrado -->
        <TextView
            android:id="@+id/tvResultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.55"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/fruit_on_surface"
            android:textSize="14sp"
            tools:text="La fruta luce en buen estado." />

        <!-- Espacio flexible inferior: empuja los botones hacia el fondo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Accion principal: añadir al inventario (filled, pildora) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="14dp"
            android:text="@string/btn_add_to_inventory"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/fruit_primary"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Accion secundaria: analizar otra fruta (discreta) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyzeAgain"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:text="@string/analyze_again"
            android:textAllCaps="false"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
