<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fruit_background"
    android:orientation="vertical"
    android:paddingBottom="32dp"
    android:paddingHorizontal="28dp"
    android:paddingTop="48dp"
    tools:context=".MainActivity">

    <!-- Cabecera: logo + titulo + subtitulo -->
    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/logo_description"
        android:src="@drawable/ic_fruit_logo" />

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/main_title"
        android:textColor="@color/fruit_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.55"
        android:gravity="center"
        android:text="@string/main_subtitle"
        android:textColor="@color/fruit_on_surface"
        android:textSize="15sp" />

    <!-- Espacio flexible: empuja el bloque de captura al centro de la pantalla -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Accion principal: camara -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:text="@string/open_camera"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/fruit_primary"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_menu_camera"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="22dp" />

    <!-- Accion secundaria: galeria -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingVertical="14dp"
        android:text="@string/select_gallery"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_menu_gallery"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:strokeColor="@color/fruit_primary" />

    <!-- Espacio flexible menor: separa visualmente captura de navegacion -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4" />

    <!-- Navegacion: inventario (verde secundario, mismo sistema, diferente jerarquia) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInventory"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:text="@string/btn_inventory"
        android:textAllCaps="false"
        android:textColor="@color/fruit_secondary"
        android:textSize="14sp"
        app:cornerRadius="28dp"
        app:icon="@android:drawable/ic_menu_agenda"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/fruit_secondary"
        app:strokeColor="@color/fruit_secondary" />

    <!-- Utilidad: cerrar sesion (muy discreto, al fondo) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:alpha="0.45"
        android:text="@string/btn_logout"
        android:textAllCaps="false"
        android:textSize="13sp" />

</LinearLayout>
